{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "game-backend",
    "Audience": "game-clients",
    "Key": "your-super-secret-jwt-key-change-this-in-production"
  },
  "Services": {
    "Auth": {
      "Url": "http://localhost:5001"
    },
    "Game": {
      "Url": "http://localhost:5002"
    },
    "Room": {
      "Url": "http://localhost:5003"
    },
    "Chat": {
      "Url": "http://localhost:5004"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=game_gateway;Username=postgres;Password=postgres"
  },
  "OpenTelemetry": {
    "Tracing": {
      "Endpoint": "http://localhost:14268/api/traces",
      "ExportProcessorType": "Batch"
    },
    "Metrics": {
      "Endpoint": "http://localhost:9090"
    }
  },
  "Consul": {
    "ServiceName": "game-api-gateway",
    "Host": "localhost",
    "Port": 5000,
    "ConsulHost": "localhost",
    "ConsulPort": 8500,
    "Tags": ["api-gateway", "game", "microservice"],
    "HealthCheck": {
      "Endpoint": "/health",
      "IntervalSeconds": 10,
      "TimeoutSeconds": 5,
      "DeregisterCriticalServicesAfterSeconds": 30
    }
  }
}
