{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=game_auth;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "this_is_a_very_secure_key_for_development_only_do_not_use_in_production_12345"
  },
  "Consul": {
    "ServiceName": "auth-service",
    "Host": "localhost",
    "Port": 5298,
    "ConsulHost": "localhost",
    "ConsulPort": 8500,
    "Tags": ["auth", "game", "microservice"],
    "HealthCheck": {
      "Endpoint": "/health",
      "IntervalSeconds": 10,
      "TimeoutSeconds": 5,
      "DeregisterCriticalServicesAfterSeconds": 30
    }
  }
}
