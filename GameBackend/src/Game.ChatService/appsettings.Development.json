{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=game_chat;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "this_is_a_very_secure_key_for_development_only_do_not_use_in_production_12345",
    "Issuer": "Game.AuthService",
    "Audience": "Game.TinyMMO"
  },
  "Consul": {
    "ServiceName": "chat-service",
    "Host": "localhost",
    "Port": 5299,
    "ConsulHost": "localhost",
    "ConsulPort": 8500,
    "Tags": ["chat", "game", "microservice"],
    "HealthCheck": {
      "Endpoint": "/health",
      "IntervalSeconds": 10,
      "TimeoutSeconds": 5,
      "DeregisterCriticalServicesAfterSeconds": 30
    }
  }
}
