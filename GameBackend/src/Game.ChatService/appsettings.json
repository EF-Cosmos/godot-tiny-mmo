{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=game_chat;Username=postgres;Password=password",
    "Redis": "localhost:6379"
  },
  "ChatService": {
    "MaxMessageLength": 500,
    "MessageHistoryLimit": 100,
    "MaxChannelsPerUser": 10,
    "EnableContentFilter": true
  },
  "Jwt": {
    "Issuer": "Game.ChatService",
    "Audience": "Game.TinyMMO",
    "Key": "development-key-for-jwt-signing-change-in-production"
  },
  "Consul": {
    "ServiceName": "chat-service",
    "Host": "localhost",
    "Port": 8090,
    "ConsulHost": "localhost",
    "ConsulPort": 8500,
    "Tags": ["chat", "game", "microservice"],
    "HealthCheck": {
      "Endpoint": "/health",
      "IntervalSeconds": 10,
      "TimeoutSeconds": 5,
      "DeregisterCriticalServicesAfterSeconds": 30
    }
  },
  "OpenTelemetry": {
    "Tracing": {
      "Endpoint": "http://localhost:14268/api/traces",
      "ExportProcessorType": "Batch"
    },
    "Metrics": {
      "Endpoint": "http://localhost:9090"
    }
  }
}
