{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Tracing": {
      "Endpoint": "http://localhost:14268/api/traces",
      "ExportProcessorType": "Batch"
    },
    "Metrics": {
      "Endpoint": "http://localhost:9090"
    }
  }
}
